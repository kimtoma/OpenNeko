<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app shell (WPF). Thin adapters over OpenNeko.Core, mirroring
       App/ on macOS. The UI is code-only (no XAML), so it references the Windows
       Desktop framework directly instead of UseWPF/UseWindowsForms: that needs no
       markup compiler, so the same project builds and publishes (win-x64) from
       Windows, Linux or macOS. It only runs on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>OpenNeko</AssemblyName>
    <RootNamespace>OpenNeko.Windows</RootNamespace>
    <ApplicationIcon>Assets\openneko.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF for windows; System.Windows.Forms only for the tray icon and monitor info. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <ProjectReference Include="..\OpenNeko.Core\OpenNeko.Core.csproj" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\openneko.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Sprites and bundled skills are shared with the macOS app; never duplicated. -->
    <Content Include="..\..\..\App\Resources\sprites\**\*" Link="Resources\sprites\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\..\App\Resources\skills\builtin\**\*" Link="Resources\skills\builtin\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\..\App\Resources\fonts\*" Link="Resources\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
